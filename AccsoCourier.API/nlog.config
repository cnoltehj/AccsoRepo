<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${basedir}/../../../logs/internal-nlog.txt">

  <!-- Load the ASP.NET Core plugin -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Define reusable log directory -->
  <variable name="logDirectory" value="${basedir}/../../../logs" />

  <!-- Targets -->
  <targets>

    <!-- All logs -->
    <target xsi:type="File"
            name="AccsoCourier.Api-All"
            fileName="${logDirectory}/AccsoCourier.API-All.log"
            archiveFileName="${logDirectory}/archive/AccsoCourier.API-All.{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            archiveEvery="Day"
            archiveAboveSize="100000000"
            maxArchiveFiles="10"
            createDirs="true"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:|${event-properties:item=EventId_Id}|${exception:format=ToString}|${callsite}}" />

    <!-- Trace logs -->
    <target xsi:type="File"
            name="AccsoCourier.Api-Trace"
            fileName="${logDirectory}/AccsoCourier.API-Trace.log"
            archiveFileName="${logDirectory}/archive/AccsoCourier.API-Trace.{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            archiveEvery="Day"
            archiveAboveSize="100000000"
            maxArchiveFiles="10"
            createDirs="true"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:|${event-properties:item=EventId_Id}|${exception:format=ToString}|${callsite}}" />

    <!-- Info logs -->
    <target xsi:type="File"
            name="AccsoCourier.Api-Info"
            fileName="${logDirectory}/AccsoCourier.API-Info.log"
            archiveFileName="${logDirectory}/archive/AccsoCourier.API-Info.{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            archiveEvery="Day"
            archiveAboveSize="100000000"
            maxArchiveFiles="30"
            createDirs="true"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:|${event-properties:item=EventId_Id}|${exception:format=ToString}|${callsite}}" />

    <!-- Error logs -->
    <target xsi:type="File"
            name="AccsoCourier.Api-Error"
            fileName="${logDirectory}/AccsoCourier.API-Error.log"
            archiveFileName="${logDirectory}/archive/AccsoCourier.API-Error.{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            archiveEvery="Day"
            archiveAboveSize="100000000"
            maxArchiveFiles="60"
            createDirs="true"
            layout="${longdate}|${uppercase:${level}}|${logger}|${message}${onexception:|${event-properties:item=EventId_Id}|${exception:format=ToString}|${callsite}}" />

  </targets>

  <!-- Rules -->
  <rules>

    <!-- All logs, including Microsoft logs -->
    <logger name="*" minlevel="Trace" writeTo="AccsoCourier.Api-All" />

    <!-- Skip non-critical Microsoft logs -->
    <logger name="Microsoft.*" maxLevel="Info" final="true" />

    <!-- Application logs -->
    <logger name="*" minlevel="Trace" writeTo="AccsoCourier.Api-Trace" />
    <logger name="*" minlevel="Info" writeTo="AccsoCourier.Api-Info" />
    <logger name="*" minlevel="Error" writeTo="AccsoCourier.Api-Error" />

  </rules>
</nlog>